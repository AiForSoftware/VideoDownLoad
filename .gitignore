# 项目内部文档（AI 接手指南 / 解析器攻关档案）现已随仓库版本化（见 docs/ 目录）

# ===== 本地用户数据 / 隐私 / 运行时产物（永不入库）=====
# mitm 抓包落盘：含视频直链与请求响应内容，属用户隐私
_captured/
# 逆向样本素材
_samples/
# 下载输出目录（用户下载的视频 / 音频 / 字幕）
vd_outputs/
# 本地配置：含各平台登录 Cookie（per_source_cookies）
config.json
# 运行 / 诊断 / 构建日志（startup.log、desktop.log、build.log …）
*.log

# ===== 构建产物 =====
# PyInstaller 工作目录
build/
# PyInstaller 输出（onedir 产物与发布压缩包）
dist/

# ===== Python 缓存 =====
__pycache__/
*.pyc
*.pyo

# ===== 虚拟环境 =====
.venv/
venv/
